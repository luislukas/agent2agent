# Copy this file to `.env` and fill in the value below. This is the only
# configuration change needed to run the project:
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up --build
#
# Docker Compose reads `.env` automatically and interpolates it into
# docker-compose.yml. `.env` is gitignored and never committed.

# Required. Used by the orchestrator for LLM-driven planning (the `math.solve`
# A2A skill and the `/solveLLM` endpoint). Get one at https://console.anthropic.com/
# The registry, add-agent and multiply-agent do not need it -- they work
# without any key at all.
ANTHROPIC_API_KEY=

# --- Optional. Everything below has a working default; leave it commented
# --- out unless you have a reason to change it.

# How often (seconds) each agent re-registers its Agent Card with the
# registry. Lower = faster recovery if the registry restarts.
#HEARTBEAT_SECONDS=30

# Maximum planning turns before the orchestrator gives up on an expression
# instead of looping forever.
#MAX_LLM_STEPS=10
